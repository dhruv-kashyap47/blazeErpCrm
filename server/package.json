{
  "name": "@blaze/server",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node ../node_modules/tsx/dist/cli.mjs watch src/index.ts",
    "build": "node ../node_modules/typescript/bin/tsc",
    "start": "node dist/index.js",
    "prisma:generate": "node --env-file=../.env ../node_modules/prisma/build/index.js generate",
    "prisma:migrate": "node --env-file=../.env ../node_modules/prisma/build/index.js migrate dev",
    "prisma:seed": "node --env-file=../.env ../node_modules/tsx/dist/cli.mjs prisma/seed.ts"
  },
  "prisma": { "seed": "tsx prisma/seed.ts" },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/morgan": "^1.9.9",
    "prisma": "^6.4.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
